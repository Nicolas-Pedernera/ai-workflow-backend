PORT=3000
DATABASE_URL=postgresql://ai_workflow_user:ai_workflow_dev@localhost:5432/ai_workflow
DATABASE_TEST_URL=postgresql://ai_workflow_user:ai_workflow_dev@localhost:5432/ai_workflow_test
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=
WORKFLOW_REGISTRY_ADDRESS=

# AI provider for local development
# mock = deterministic provider for tests
# ollama = local AI inference, no API key required, keeps data private
# remote = OpenAI-compatible API (OpenAI, Groq, OpenRouter, DeepSeek, etc.)
AI_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
REMOTE_AI_API_KEY=
REMOTE_AI_BASE_URL=https://api.openai.com/v1
REMOTE_AI_MODEL=gpt-4o-mini
